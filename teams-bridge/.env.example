
PROCESSGUARD_BASE_URL="http://127.0.0.1:5003"

BRIDGE_PUBLIC_URL="http://10.8.10.97:5010"
BRIDGE_BIND_HOST="0.0.0.0"
BRIDGE_PORT=5010

# Existing/default Microsoft Teams Workflow webhook. 
TEAMS_WORKFLOW_WEBHOOK_URL="https://REPLACE-WITH-YOUR-WORKFLOW-URL"

# Optional channel-specific Workflow URLs. Leave blank to use the existing
# TEAMS_WORKFLOW_WEBHOOK_URL instead.
QUALITY_TEAMS_WEBHOOK_URL=""
SUPERVISOR_TEAMS_WEBHOOK_URL=""
MAINTENANCE_TEAMS_WEBHOOK_URL=""

# Create separate ProcessGuard integration tokens for these departments.
QUALITY_PAGER_TOKEN=""
SUPERVISOR_PAGER_TOKEN=""
MAINTENANCE_PAGER_TOKEN=""

# Generate a unique random value of at least 32 characters.
ACK_LINK_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
ACK_LINK_TTL_MINUTES=1440

POLL_INTERVAL_MS=5000
HTTP_TIMEOUT_MS=7000

# False prevents old alerts from flooding Teams the first time the bridge starts.
NOTIFY_EXISTING_ALERTS_ON_START=false

# Stored in ProcessGuard as the responder when a passwordless Teams link is used.
ACK_RESPONDER_PREFIX="Teams"
STATE_FILE="./data/state.json"
