# PostgreSQL connection string.
# Windows local example:
# DATABASE_URL="postgresql://processguard:CHANGE_THIS_PASSWORD@localhost:5432/processguard?schema=public"
DATABASE_URL="postgresql://processguard:processguard_dev_password@localhost:5432/processguard?schema=public"

# API/web port. Your M5 firmware currently uses port 5003.
PORT=5003
HOST=0.0.0.0

# Used to sign browser session JWTs. Use a long random value in production.
JWT_SECRET="t/6yi1MmL4mrouylXysAyuu9pdpY/2vG4UM6uAmPv95CpMrg7TLKqyBQ3GwvXAMp"

# Allow one-click demo role sign-in on /login.
# Set to false for production.
DEMO_MODE=false

# Serve the built React UI from the API server in production.
SERVE_WEB=true

# CORS origin for local Vite development. In production, same-origin is used.
CORS_ORIGIN="http://localhost:5003"

# Optional external URL shown in logs/docs.
PUBLIC_URL="http://192.168.26.2:5003"

# Timezone used for report date filters and daily trend grouping.
REPORT_TIME_ZONE="America/Chicago"

POWER_AUTOMATE_WEBHOOK_URL="https://defaultaa4430332ae64fa4aac143ec6d3e24.1f.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/05/workflows/85194694078f43bcb4b6b434409b6ffb/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=4bDdb5cL0gkVsFOpmd9CIypTfPnnaBFvoKvCWnJDg0Y"
POWER_AUTOMATE_QUALITY_WEBHOOK_URL=""
POWER_AUTOMATE_SUPERVISOR_WEBHOOK_URL=""
POWER_AUTOMATE_MAINTENANCE_WEBHOOK_URL=""
# Seed behavior. If true, npm run db:seed creates demo data/users/pager tokens.
SEED_DEMO=false
